# Application
APP_NAME=Autonomous SWE Agent
DEBUG=false

# Database（默认 SQLite，无需 Docker 即可跑通；生产可改为 PostgreSQL + pgvector）
DATABASE_URL=sqlite:///./swe_agent.db

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o

# Sandbox（默认本地 subprocess；生产可接入 e2b/docker）
SANDBOX_PROVIDER=local
E2B_API_KEY=

# Application
APP_NAME=Autonomous SWE Agent
DEBUG=false

# Database（默认 SQLite，无需 Docker 即可跑通；生产可改为 PostgreSQL + pgvector）
DATABASE_URL=sqlite:///./swe_agent.db

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# LLM
OPENAI_API_KEY=
# OpenAI 兼容接口地址（如 DeepSeek：https://api.deepseek.com/v1；留空用官方 OpenAI）
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
TASK_MAX_INPUT_TOKENS=8000000
TASK_MAX_OUTPUT_TOKENS=250000
TASK_MAX_LLM_CALLS=128
TASK_MAX_COST_USD=2.0

# Code retrieval (hashing | fastembed | openai; memory | pgvector)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-en
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_DIR=./.fastembed_cache
EMBEDDING_MODEL_PATH=
RAG_VECTOR_STORE=memory
RAG_VECTOR_THRESHOLD=0.1

# Sandbox（local 本地 subprocess / docker 容器 / e2b 云端）
SANDBOX_PROVIDER=local
E2B_API_KEY=
E2B_TEMPLATE=base
DOCKER_IMAGE=python:3.12-slim

# Backend
DATABASE_URL=sqlite:///./swe_agent.db
REDIS_URL=redis://localhost:6379/0
TASK_BACKEND=thread
WORKER_MAX_RETRIES=3
SANDBOX_PROVIDER=local
WORKDIR=./workspace
ARTIFACT_DIR=./artifacts
REPOSITORY_ALLOWED_HOSTS=github.com
ALLOW_LOCAL_REPOSITORIES=true

# Configure one provider to enable real Agent execution.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0

# Retrieval: hashing+memory is the zero-download default. For persistent neural
# retrieval use EMBEDDING_PROVIDER=fastembed and RAG_VECTOR_STORE=pgvector with
# PostgreSQL. Preload the model into EMBEDDING_CACHE_DIR for offline workers.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-en
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_DIR=./.fastembed_cache
EMBEDDING_MODEL_PATH=
RAG_VECTOR_STORE=memory
RAG_VECTOR_THRESHOLD=0.1

# Required only after approval when publishing a GitHub PR.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GIT_AUTHOR_NAME=Autonomous SWE Agent
GIT_AUTHOR_EMAIL=agent@example.invalid

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
